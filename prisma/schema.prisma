generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// サイトにお店は 1 つだけ。行は id = 1 の 1 行だけで、最初にお店を作った人がオーナーになる
model StoreSettings {
  id                  Int      @id @default(1)
  ownerSub            String
  name                String
  description         String?
  logoPath            String?
  headerPath          String?
  themeColor          String   @default("#e85d8f")
  isPublished         Boolean  @default(false)
  paymentInstructions String?
  contactEmail        String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model Product {
  id          String         @id @default(uuid()) @db.Uuid
  name        String
  description String?
  price       Int
  stock       Int
  isPublished Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  images      ProductImage[]
  cartItems   CartItem[]
  orderItems  OrderItem[]

  @@index([createdAt])
}

model ProductImage {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @db.Uuid
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  path      String
  sortOrder Int
  createdAt DateTime @default(now())

  @@index([productId, sortOrder])
}

enum OrderStatus {
  RECEIVED
  PAID
  SHIPPED
  CANCELED
}

model CartItem {
  id        String   @id @default(uuid()) @db.Uuid
  buyerSub  String
  productId String   @db.Uuid
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([buyerSub, productId])
  @@index([buyerSub, createdAt])
}

model Order {
  id                  String      @id @default(uuid()) @db.Uuid
  storeName           String
  paymentInstructions String?
  buyerSub            String
  buyerName           String
  buyerEmail          String
  postalCode          String
  prefecture          String
  address             String
  phone               String
  status              OrderStatus @default(RECEIVED)
  totalAmount         Int
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  items               OrderItem[]

  @@index([status, createdAt])
  @@index([buyerSub, createdAt])
}

model OrderItem {
  id          String   @id @default(uuid()) @db.Uuid
  orderId     String   @db.Uuid
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?  @db.Uuid
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName String
  unitPrice   Int
  quantity    Int

  @@index([orderId])
}
