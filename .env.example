# openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-secret"
# Needed for `npm start` outside Vercel (Vercel and `npm run dev` trust the host automatically)
AUTH_TRUST_HOST="true"
# Candy Rain ID (candy-rain-identity-server). Register
# <this app's origin>/api/auth/callback/candy-rain-id as a redirect URI there.
AUTH_CANDY_RAIN_ID_ISSUER="http://localhost:8080"
AUTH_CANDY_RAIN_ID_ID=""
AUTH_CANDY_RAIN_ID_SECRET=""
