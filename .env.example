# openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-secret"
# Needed for `npm start` outside Vercel (Vercel and `npm run dev` trust the host automatically)
AUTH_TRUST_HOST="true"
# Candy Rain ID (candy-rain-identity-server). Register this app in its
# OIDC_CLIENTS with <this app's origin>/api/auth/callback/candy-rain-id as a redirect URI.
AUTH_CANDY_RAIN_ID_ISSUER="http://localhost:8080"
AUTH_CANDY_RAIN_ID_ID="candy-rain-stores"
AUTH_CANDY_RAIN_ID_SECRET=""

# Postgres. DIRECT_URL (non-pooled) is used for migrations; falls back to DATABASE_URL.
DATABASE_URL="postgresql://user:password@localhost:5432/stores"
DIRECT_URL="postgresql://user:password@localhost:5432/stores"

# Store image storage (Supabase Storage, public bucket "store-images"). Server-only: never prefix with NEXT_PUBLIC_.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
# Set to "memory" to keep images in process memory (tests / local without Supabase)
IMAGE_STORAGE=""
